# Site settings read at build time. None of these are secrets.
# Hosts such as Netlify and Vercel can override them in their environment settings.

# Full address of the live site, no trailing slash. PLACEHOLDER until the domain is known.
VITE_SITE_URL=https://[DOMAIN]

# Form service URL that enquiries are posted to, for example https://formspree.io/f/abcdwxyz
# Empty = demo mode: the form shows its success state but sends nothing.
VITE_FORM_ENDPOINT=

# Shown as the fallback contact if sending fails. PLACEHOLDER until supplied.
VITE_ENQUIRY_EMAIL=[EMAIL]
